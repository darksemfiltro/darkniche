# Copie para ~/.analise-mercado-yt/.env e preencha. Nunca coloque o arquivo real num repositório.
# Chave da YouTube Data API v3 (Google Cloud Console > APIs e serviços > Credenciais). Restrinja-a à YouTube Data API v3.
YT_API_KEY=
# Opcional: só para scripts/gemini_video.py (análise de motion por vídeo)
GEMINI_API_KEY=
# Opcional: e-mail ou URL de contato. Vai no User-Agent das consultas à Wikipédia (a política da Wikimedia pede um contato).
AMY_CONTACT=
# Opcionais: tetos locais por dia (padrões: 9500 unidades gerais e 95 buscas)
YT_DAILY_BUDGET=9500
YT_SEARCH_DAILY_BUDGET=95
